<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>NBA Fantezi Lig</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏀</text></svg>">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#f4f5f7;--panel:#fff;--fg:#141922;--muted:#5d6676;--line:#dde1e7;--a:#1f5fd1;--b:#e3792b;--ok:#17834a;--bad:#c23b3b;--chip:#eef1f5;color-scheme:light}
@media (prefers-color-scheme:dark){:root{--bg:#0f1319;--panel:#171c24;--fg:#e8ecf2;--muted:#9aa4b5;--line:#2a313c;--a:#5b8ff0;--b:#f0974f;--ok:#43c07a;--bad:#ef6b6b;--chip:#1f2630;color-scheme:dark}}
*{box-sizing:border-box}
html,body{height:100%}
body{margin:0;display:flex;flex-direction:column;height:100vh;height:100dvh;overflow:hidden;background:var(--bg);color:var(--fg);font-family:Barlow,system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;font-size:15px;line-height:1.45;-webkit-tap-highlight-color:transparent}
.wrap{max-width:760px;margin:0 auto;padding:0 14px}
header.top{flex:none;z-index:5;background:var(--bg);padding-top:env(safe-area-inset-top,0px);border-bottom:1px solid var(--line)}
.hrow{display:flex;justify-content:space-between;align-items:baseline;padding:10px 0 8px}
h1{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.6rem;margin:0;line-height:1}
h2{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.25rem;margin:0 0 8px}
h3{font-size:1rem;margin:12px 0 4px}
.upd{color:var(--muted);font-size:.8rem}
.note{color:var(--muted);font-size:.83rem;margin:4px 0 10px}
.seg{display:grid;grid-template-columns:1fr 1fr;gap:4px;background:var(--chip);border-radius:9px;padding:3px;margin-bottom:10px}
.seg button{font:inherit;font-size:.9rem;border:0;background:none;color:var(--muted);padding:7px;border-radius:7px;cursor:pointer}
.seg button.on{background:var(--panel);color:var(--fg);font-weight:600;box-shadow:0 0 0 1px var(--line)}
main{flex:1;min-height:0;overflow-y:auto;-webkit-overflow-scrolling:touch;overscroll-behavior:contain}
main>.wrap{padding-top:12px;padding-bottom:28px}
.chips{display:flex;gap:6px;overflow-x:auto;padding:2px 0 6px;margin-bottom:4px;scrollbar-width:none}
.chips::-webkit-scrollbar{display:none}
.chips button{flex:none;font:inherit;font-size:.82rem;padding:5px 12px;border-radius:99px;border:1px solid var(--line);background:var(--panel);color:var(--fg);cursor:pointer}
.chips button.on{background:var(--a);border-color:var(--a);color:#fff;font-weight:600}
.sub{display:flex;gap:16px;overflow-x:auto;border-bottom:1px solid var(--line);margin:6px 0 12px;scrollbar-width:none}
.sub::-webkit-scrollbar{display:none}
.sub button{flex:none;font:inherit;font-size:.88rem;border:0;background:none;color:var(--muted);padding:7px 0;border-bottom:2px solid transparent;cursor:pointer}
.sub button.on{color:var(--fg);font-weight:600;border-bottom-color:var(--a)}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:12px 14px;margin-bottom:10px}
.wrow{display:grid;grid-template-columns:78px 1fr 46px;gap:2px 10px;align-items:center;padding:7px 0;border-bottom:1px solid var(--line)}
.wrow:last-child{border-bottom:0}
.wrow .wl{font-weight:600;display:flex;gap:6px;align-items:center}
.wrow .ws{grid-column:1/-1;font-size:.76rem;color:var(--muted)}
.wrow .wp{text-align:right;font-variant-numeric:tabular-nums;font-weight:600}
.bar{height:9px;border-radius:5px;background:var(--chip);overflow:hidden}
.bar i{display:block;height:100%;border-radius:5px;background:var(--muted)}
.bar i.win{background:var(--ok)}.bar i.loss{background:var(--bad)}
.win{color:var(--ok)}.loss{color:var(--bad)}.mut{color:var(--muted)}
.kpis{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:10px}
.kpi{background:var(--chip);border-radius:9px;padding:9px 12px}
.kpi span{display:block;font-size:.76rem;color:var(--muted)}.kpi b{font-size:1.3rem}
.tag{display:inline-block;padding:0 6px;border-radius:99px;font-size:.68rem;font-weight:600;background:var(--chip);color:var(--muted)}
.tag.punt{color:var(--bad)}.tag.pri{color:var(--a)}.tag.keep{color:var(--ok)}
.pl{display:flex;align-items:center;gap:8px;padding:7px 0;border-bottom:1px solid var(--line);cursor:pointer}
.pl:last-child{border-bottom:0}.pl input{width:18px;height:18px;flex:none;accent-color:var(--a)}
.pl .pn{flex:1;min-width:0}.pl .pm{font-size:.76rem;color:var(--muted)}.pl .pv{font-variant-numeric:tabular-nums;font-weight:600}
.big{font-family:"Barlow Condensed",sans-serif;font-size:2rem;font-weight:700;line-height:1}
.warn{font-size:.82rem;margin:3px 0}.warn.hard{color:var(--bad)}.warn.soft{color:var(--muted)}
.msel{display:flex;justify-content:center;gap:10px;margin:0 0 12px}
.msel button{width:36%;font:inherit;font-size:.8rem;padding:4px 0;border-radius:99px;border:1px solid var(--line);background:var(--panel);color:var(--muted);cursor:pointer}
.msel button.on{background:var(--a);border-color:var(--a);color:#fff;font-weight:600}
.scol{display:grid;grid-template-columns:1fr 1fr;gap:8px}.scol .card{padding:8px 9px;margin-bottom:0}
.sp{display:flex;gap:7px;align-items:flex-start;padding:6px 0;border-bottom:1px solid var(--line);cursor:pointer;font-size:.86rem;line-height:1.25}
.sp:last-child{border-bottom:0}.sp input{width:16px;height:16px;margin:1px 0 0;accent-color:var(--a);flex:none}.sp>span>span{display:block}
.sm{font-size:.74rem;color:var(--muted)}
.sbar{display:grid;grid-template-columns:2fr 1fr;gap:8px;margin:10px 0 18px}
.btnp{font:inherit;font-weight:600;border:0;border-radius:9px;padding:9px;background:var(--a);color:#fff;cursor:pointer}.btnp:disabled{opacity:.45}
.btns{font:inherit;border:1px solid var(--line);border-radius:9px;padding:9px;background:var(--panel);color:var(--fg);cursor:pointer}
.cu{color:var(--ok)}.cd{color:var(--bad)}.cm{color:var(--muted)}
.rhd{display:flex;justify-content:space-between;align-items:baseline;margin:4px 0 2px}
.rttl{font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:1.2rem}
.plb{font-size:.75rem;font-weight:600}
.hero{border-radius:14px;padding:11px 13px;display:grid;grid-template-columns:1fr 1fr}
.hero.ok{background:color-mix(in srgb,var(--ok) 13%,transparent);color:var(--ok)}.hero.bad{background:color-mix(in srgb,var(--bad) 12%,transparent);color:var(--bad)}.hero.neu{background:var(--chip);color:var(--fg)}
.hero>div+div{border-left:1px solid color-mix(in srgb,currentColor 25%,transparent);padding-left:13px}
.hero .l{font-size:.82rem;opacity:.85}.hero .n{font-size:1.6rem;font-weight:600;line-height:1.2;margin:1px 0}.hero .n small{font-size:.78rem;font-weight:400}
.warnl{font-size:.8rem;margin:6px 0 0;color:var(--bad)}.warnl.s{color:var(--muted)}
.secl{font-size:.75rem;color:var(--muted);font-weight:600;margin:0 0 7px}
.ibox{border:1px solid var(--line);border-radius:14px;padding:10px 8px 8px;margin-top:14px;background:var(--panel)}
.igrid,.fgrid{display:grid;grid-template-columns:38px repeat(9,1fr);text-align:center;align-items:center;border:1px solid var(--line);border-radius:10px;font-size:.74rem;font-variant-numeric:tabular-nums}
.igrid{row-gap:4px;padding:6px 0}.fgrid{padding:6px 0;margin-top:8px;background:var(--chip)}
.igrid .k{color:var(--muted);border-bottom:1px solid var(--line);padding-bottom:3px}
.igrid .rl,.fgrid .rl{text-align:left;color:var(--muted);padding-left:6px}.igrid .rl.h{border-bottom:1px solid var(--line);align-self:stretch}
.igrid .o{color:var(--muted)}.igrid .a{font-weight:600}.fgrid .d{font-size:1rem;font-weight:700}
.hrl{border-top:1px solid var(--line);margin:20px 0}
.pcs{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.pcard{border:1px solid var(--line);border-radius:12px;padding:8px 7px;margin-bottom:8px;background:var(--panel)}
.pcard.g{border-color:color-mix(in srgb,var(--bad) 45%,var(--line))}.pcard.r{border-color:color-mix(in srgb,var(--ok) 45%,var(--line))}
.pcard .nm{font-weight:600;font-size:.95rem;margin-top:1px}
.sg5,.sg4{display:grid;text-align:center;margin-top:8px;font-variant-numeric:tabular-nums}.sg5{grid-template-columns:repeat(6,1fr)}.sg4{grid-template-columns:repeat(4,1fr);margin-top:6px}
.sg5>span>span,.sg4>span>span{display:block;font-size:.72rem}.sk{color:var(--muted)}.sv.w{color:var(--ok);font-weight:700}
.rfoot{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:.75rem;border-top:1px solid var(--line);padding-top:8px;margin-top:4px}
.psep{display:flex;align-items:center;gap:8px;margin:26px 0 8px;color:var(--muted);font-size:.75rem}
.psep::before,.psep::after{content:"";flex:1;border-top:1px solid var(--line)}
#fo-sub{flex-wrap:wrap;gap:6px}#fo-sub button{width:auto;padding:4px 11px}
.fc{border:1px solid var(--line);border-radius:12px;padding:8px 10px;margin-top:8px;background:var(--panel)}
.ftop{display:flex;justify-content:space-between;align-items:baseline;gap:6px}.fnm{font-weight:600;font-size:.92rem}.fnm small{font-weight:400;font-size:.72rem;color:var(--muted)}
.fr{font-weight:700;font-size:.92rem;white-space:nowrap}
.fwk{display:grid;grid-template-columns:repeat(7,1fr);gap:3px;margin-top:6px;text-align:center}.fwk span{border-radius:4px;font-size:.7rem;padding:1px 0;background:var(--chip);color:var(--muted)}
.fwk .g{background:color-mix(in srgb,var(--ok) 16%,transparent);color:var(--ok);font-weight:600}.fwk .gl{background:var(--ok);color:#fff;font-weight:700}.fwk .past{opacity:.45}
.fst{display:grid;grid-template-columns:repeat(9,1fr);text-align:center;margin-top:6px;font-variant-numeric:tabular-nums}.fst>span>span{display:block}.fst .k{font-size:.66rem;color:var(--muted)}.fst .n{font-size:.82rem;font-weight:600}
.fln{font-size:.72rem;color:var(--muted);margin-top:4px}
.finj{background:var(--chip);border-radius:10px;padding:7px 10px;margin-top:14px}.fih{font-weight:700}.fih small{font-weight:400;color:var(--muted)}
.fsrch{width:100%;font:inherit;padding:7px 10px;border:1px solid var(--line);border-radius:9px;background:var(--panel);color:var(--fg);margin-bottom:8px}
.fgr{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin-bottom:6px}.fgr label{font-size:.72rem;color:var(--muted);display:flex;flex-direction:column;gap:2px}.fgr select{font:inherit;font-size:.82rem;padding:5px;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:var(--fg)}
.fchips{display:flex;flex-wrap:wrap;gap:5px;margin:4px 0 6px}.fch{font:inherit;font-size:.74rem;padding:3px 9px;border-radius:99px;border:1px solid var(--line);background:var(--panel);color:var(--muted);cursor:pointer}.fch.on{background:color-mix(in srgb,var(--a) 15%,transparent);border-color:var(--a);color:var(--a);font-weight:600}
.fpt td{font-variant-numeric:tabular-nums}.fpt td.hl{background:color-mix(in srgb,var(--ok) 14%,transparent);color:var(--ok);font-weight:600}.fpt tr[data-id]{cursor:pointer}.fopen td{padding:0 0 6px!important;text-align:left}.fopen .fc *{white-space:normal}.fopen .fc{position:sticky;left:0;width:calc(min(100vw,760px) - 34px);box-sizing:border-box;margin-top:4px}
.pm{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.45);display:flex;align-items:flex-end;justify-content:center}.pm[hidden]{display:none}
.pmb{background:var(--bg,var(--panel));width:100%;max-width:760px;height:92vh;height:92dvh;border-radius:16px 16px 0 0;display:flex;flex-direction:column;padding:12px 14px 0}
.pmhd{display:flex;justify-content:space-between;align-items:flex-start;gap:8px}.pmn{font-size:1.15rem;font-weight:700}#pm-x{font:inherit;font-size:1.1rem;border:0;background:var(--chip);color:var(--fg);border-radius:99px;width:34px;height:34px;flex:none;cursor:pointer}
#pm-sub{margin:10px 0 4px}#pm-out{overflow-y:auto;flex:1;padding-bottom:calc(16px + env(safe-area-inset-bottom,0px))}
.plog td,.plog th{font-size:.72rem;padding:5px 3px!important;text-align:center;font-variant-numeric:tabular-nums;white-space:nowrap}.plog td:first-child{text-align:left}.plog .pavg td{font-weight:600;background:var(--chip)}.plog .dnp td{color:var(--muted);font-style:italic}
#pm-out h4{margin:16px 0 6px;font-size:.92rem}.pgrid{display:grid;grid-template-columns:1fr 1fr;gap:6px}.pgrid div{background:var(--chip);border-radius:9px;padding:6px 9px}.pgrid span{display:block;font-size:.7rem;color:var(--muted)}.pgrid b{font-size:.9rem}
.pinj{margin-top:8px;border-left:3px solid var(--bad,#d33);padding:4px 9px;background:var(--chip);border-radius:6px;font-size:.85rem}
.pbars{display:grid;gap:4px}.pbar{display:grid;grid-template-columns:44px 1fr 38px;align-items:center;gap:6px;font-size:.78rem}.pbar em{font-style:normal;text-align:right;font-variant-numeric:tabular-nums}.pbar .pt{position:relative;height:10px;background:var(--chip);border-radius:5px}.pbar .pt::after{content:"";position:absolute;left:50%;top:-2px;bottom:-2px;width:1px;background:var(--line)}.pbar i{position:absolute;top:0;bottom:0;border-radius:5px}.pbar i.pos{background:var(--ok)}.pbar i.neg{background:var(--bad,#d33)}.pbar.pun{opacity:.4}
.psea{background:var(--chip);border-radius:10px;padding:8px 10px}.psea .fst .n{font-size:.95rem;font-weight:700}.psea .fst .k{font-size:.7rem}.ptips{margin:0;padding-left:18px;font-size:.86rem;line-height:1.45}.ptips li{margin:3px 0}.fc[data-pid]{cursor:pointer}
.tw{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--panel);margin-bottom:10px}
table{border-collapse:collapse;width:100%;font-size:.85rem;font-variant-numeric:tabular-nums}
th,td{padding:6px 8px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
th{color:var(--muted);font-weight:600;background:var(--chip);position:sticky;top:0}
th:first-child,td:first-child,th.l,td.l{text-align:left}
tr:last-child td{border-bottom:0}
tr.sel td{font-weight:600}tr.sel td:first-child{box-shadow:inset 3px 0 0 var(--a)}
td.win{font-weight:600}
table.small{font-size:.76rem}table.small th,table.small td{padding:4px 5px}
td.ba{line-height:1.15}td.ba .o{color:var(--muted);display:block}td.ba .n{display:block;font-weight:600}
td.ba.up .n{color:var(--ok)}td.ba.dn .n{color:var(--bad)}
details.tc{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:10px 12px;margin-bottom:8px}
details.tc summary{list-style:none;cursor:pointer}
details.tc summary::-webkit-details-marker{display:none}
.tch{display:flex;justify-content:space-between;font-weight:600}
.tch .car{color:var(--muted);transition:transform .15s}details[open] .tch .car{transform:rotate(180deg)}
.tcb{color:var(--muted);font-size:.85rem;margin:3px 0 4px}
.dch{display:inline-block;font-size:.72rem;font-weight:600;padding:1px 6px;border-radius:6px;margin:3px 3px 0 0}
.dch.up{background:color-mix(in srgb,var(--ok) 15%,transparent);color:var(--ok)}
.dch.dn{background:color-mix(in srgb,var(--bad) 15%,transparent);color:var(--bad)}
.tcx{font-size:.83rem;margin:8px 0 0;padding-left:1.1em}.tcx li{margin:3px 0}
select{font:inherit;font-size:.92rem;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--panel);color:var(--fg);width:100%}
.pick{display:grid;grid-template-columns:1fr auto 1fr;gap:8px;align-items:center;margin-bottom:6px}
.vs{font-family:"Barlow Condensed",sans-serif;font-weight:700;color:var(--muted)}
.score{text-align:center;font-family:"Barlow Condensed",sans-serif;font-weight:700;font-size:2.6rem;line-height:1.1;margin:6px 0 0}
.score .a{color:var(--a)}.score .b{color:var(--b)}
.verdict{text-align:center;color:var(--muted);font-size:.85rem;margin-bottom:10px}
.cat{display:grid;grid-template-columns:52px 1fr 40px 1fr 52px;gap:6px;align-items:center;font-variant-numeric:tabular-nums;font-size:.85rem;padding:3px 0}
.cat .va{text-align:right}.cat .lbl{text-align:center;font-family:"Barlow Condensed",sans-serif;font-weight:700;color:var(--muted)}
.cat .wa{color:var(--a);font-weight:700}.cat .wb{color:var(--b);font-weight:700}
.track{height:10px;border-radius:4px;background:var(--chip);position:relative;overflow:hidden}
.track span{position:absolute;top:0;bottom:0;border-radius:4px}
.track.a span{right:0;background:var(--a)}.track.b span{left:0;background:var(--b)}
.pill{display:inline-block;padding:1px 8px;border-radius:99px;font-size:.74rem;font-weight:600}
.pill.win{background:color-mix(in srgb,var(--ok) 15%,transparent)}.pill.loss{background:color-mix(in srgb,var(--bad) 15%,transparent)}
.pill.tie{background:var(--chip);color:var(--muted)}
.btn{font:inherit;font-size:.82rem;padding:5px 12px;border-radius:99px;border:1px solid var(--line);background:var(--panel);color:var(--fg);cursor:pointer;margin:0 0 10px}
.notes{white-space:pre-wrap;font-size:.9rem}
.strat ul{margin:4px 0;padding-left:1.2em;font-size:.9rem}
nav.tabs{flex:none;z-index:6;background:var(--panel);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
nav.tabs .in{max-width:760px;margin:0 auto;display:grid;grid-template-columns:repeat(6,1fr)}
nav.tabs button{font:inherit;font-size:.66rem;border:0;background:none;color:var(--muted);display:flex;flex-direction:column;align-items:center;gap:2px;padding:7px 0 8px;cursor:pointer}
nav.tabs svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
nav.tabs button.on{color:var(--a);font-weight:600}
.err{color:var(--bad)}
[hidden]{display:none!important}
</style>
</head>
<body>
<header class="top"><div class="wrap"><div class="hrow"><h1>NBA Fantezi Lig Sezon 6</h1></div></div></header>
<main><div class="wrap">
 <div class="chips" id="lg-wk"></div>
 <p class="upd" id="lg-upd" style="margin:0"></p>
 <div class="sub" id="lg-sub"></div>
 <div id="lg-out"><p class="note">Lig verisi yükleniyor…</p></div>
</div></main>
<script>
const CATS = ["fgp", "ftp", "tpm", "pts", "reb", "ast", "st", "blk", "to"];
const LBL = { fgp: "FG%", ftp: "FT%", tpm: "3PM", pts: "PTS", reb: "REB", ast: "AST", st: "ST", blk: "BLK", to: "TO" };
const SHORT = {};
const $ = id => document.getElementById(id);
const esc = s => String(s).replace(/[&<>"]/g, c => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
const pc = v => Math.round(v * 100) + "%";
const f3 = v => isFinite(v) ? v.toFixed(3).replace(/^0/, "") : "–";
const f1 = v => isFinite(v) ? v.toFixed(1) : "–";
const cls = v => v >= .6 ? "win" : v < .4 ? "loss" : "";
const better = (k, x, y) => k === "to" ? x < y : x > y;
const Q = new URLSearchParams(location.search);
function setQ(o) { const u = new URL(location); Object.entries(o).forEach(([k, v]) => u.searchParams.set(k, v)); history.replaceState(null, "", u); }
function chipRow(box, items, active, onPick) {
  box.replaceChildren(...items.map(([k, l]) => { const b = document.createElement("button"); b.textContent = l; b.dataset.k = k; if (k === active) b.className = "on"; b.onclick = () => onPick(k); return b; }));
  const on = box.querySelector(".on"); if (on) on.scrollIntoView({ block: "nearest", inline: "center" });
}
function teamOpts(id, val, list) { return `<select id="${id}">${list.map(t => `<option${t === val ? " selected" : ""}>${esc(t)}</option>`).join("")}</select>`; }
let DATA = null, cur = null, view = "lg";
let lgWk = Q.get("w") || null, lgSub = Q.get("s") || "h2h", lgA = Q.get("a") || null, lgB = Q.get("b") || null, catAll = false;
function vals(rows, perGame) {
  return rows.map(r => { const g = perGame ? (r.gp || 1) : 1;
    return { team: r.team, gp: r.gp, raw: r, fgp: r.fgm / r.fga, ftp: r.ftm / r.fta, tpm: r.tpm / g, pts: r.pts / g, reb: r.reb / g, ast: r.ast / g, st: r.st / g, blk: r.blk / g, to: r.to / g }; });
}
function addSeason(d) {
  const ks = Object.keys(d.weeks).filter(k => k !== "all").sort((a, b) => a - b); const acc = {};
  ks.forEach(k => d.weeks[k].teams.forEach(t => {
    const a = acc[t.team] || (acc[t.team] = { team: t.team, gp: 0, fgm: 0, fga: 0, ftm: 0, fta: 0, tpm: 0, pts: 0, reb: 0, ast: 0, st: 0, blk: 0, to: 0 });
    ["gp", "fgm", "fga", "ftm", "fta", "tpm", "pts", "reb", "ast", "st", "blk", "to"].forEach(f => a[f] += (t[f] || 0)); }));
  const last = d.weeks[ks[ks.length - 1]];
  d.weeks.all = { label: "Sezon toplamı (Hafta " + ks[0] + "-" + ks[ks.length - 1] + ")", updated: last.updated, teams: Object.values(acc) };
}
const weekKeys = () => Object.keys(DATA.weeks).filter(w => w !== "all").sort((a, b) => a - b);
const weekItems = () => weekKeys().map(w => [w, "H" + w]).concat([["all", "Sezon"]]);
function cmp(a, b) { let w = 0, l = 0; CATS.forEach(k => { if (better(k, a[k], b[k])) w++; else if (better(k, b[k], a[k])) l++; }); return { w, l, t: 9 - w - l }; }
const SUBS = [["h2h", "Eşleşme"], ["all", "Herkese karşı"], ["pow", "Güç"], ["cat", "Kategori"], ["tot", "Toplam"], ["pg", "Maç başı"], ["val", "Değerler"]];
let DEG = null, degM = Q.get("dm") === "tm" ? "tm" : "pl", degT = Q.get("dt") || "", degS = "v";
function loadDeg() {
  if (DEG) return; DEG = 0;
  fetch("degerler.json?v=" + Date.now()).then(r => r.ok ? r.json() : null).then(d => { DEG = d || { players: [] }; if (view === "lg" && lgSub === "val") renderLeague(); })
    .catch(() => { DEG = null; $("lg-out").innerHTML = "<p class='err'>Değerler yüklenemedi. Sayfayı yenile.</p>"; });
}
function renderDeg() {
  const out = $("lg-out");
  if (!DEG) { loadDeg(); out.innerHTML = "<p class='note'>Değerler yükleniyor…</p>"; return; }
  const P = DEG.players, tn = t => t === "FA" ? "FA" : (SHORT[t] || t);
  const dif = p => p.d == null ? null : p.v - p.d;
  const fx = x => x == null ? "<td class='mut'>–</td>" : `<td class="${x > 0 ? "win" : x < 0 ? "loss" : "mut"}">${x > 0 ? "+" : ""}${x}</td>`;
  const T = {}; P.forEach(p => { if (p.t === "FA") return; const o = T[p.t] = T[p.t] || { t: p.t, d: 0, v: 0 }; o.d += p.d || 0; o.v += p.v; });
  const TL = Object.values(T).sort((a, b) => b.v - a.v);
  let h = `<p class="note">Güncel $: sezon öncesi hedef fiyat + 9-kat z-skoru + haftalık kazanma (H2H, punt) karışımı; bu sezonun verisi ağırlığı maç sayısıyla artar. Draft $: lig draft fiyatı (FA = draftta seçilmedi, fark hesaplanmaz). Güncelleme: ${esc(DEG.updated || "")}.</p>
<div class="msel" id="dg-m"><button data-m="pl"${degM === "pl" ? ' class="on"' : ""}>Oyuncular</button><button data-m="tm"${degM === "tm" ? ' class="on"' : ""}>Takımlar</button></div>`;
  if (degM === "tm") {
    h += `<p class="note">Takıma dokun: o takımın oyuncuları açılır. Fark, waiver'dan alınan oyuncuların kazancını da içerir.</p><div class="tw"><table><thead><tr><th>#</th><th class="l">Takım</th><th>Draft $</th><th>Güncel $</th><th>Fark</th></tr></thead><tbody>` +
      TL.map((o, i) => `<tr data-t="${esc(o.t)}" class="${o.t === cur ? "sel" : ""}" style="cursor:pointer"><td>${i + 1}</td><td class="l">${esc(o.t)}</td><td>${o.d}</td><td><b>${o.v}</b></td>${fx(o.v - o.d)}</tr>`).join("") + "</tbody></table></div>";
  } else {
    const opts = [["", "Tüm oyuncular"], ...TL.map(o => [o.t, o.t]), ["FA", "Serbest (FA)"]];
    h += `<div class="pick" style="gap:8px;display:flex"><select id="dg-t" style="flex:1;min-width:0">${opts.map(([k, l]) => `<option value="${esc(k)}"${k === degT ? " selected" : ""}>${esc(l)}</option>`).join("")}</select>
<select id="dg-s" style="flex:1;min-width:0">${[["v", "Güncel değere göre"], ["up", "En çok kazanan"], ["dn", "En çok kaybeden"]].map(([k, l]) => `<option value="${k}"${k === degS ? " selected" : ""}>${l}</option>`).join("")}</select></div>`;
    let L2 = P.filter(p => !degT || p.t === degT);
    if (degS !== "v") L2 = L2.filter(p => p.d != null).sort((a, b) => degS === "up" ? dif(b) - dif(a) : dif(a) - dif(b));
    if (degT && T[degT]) { const o = T[degT]; h += `<div class="kpis" style="margin:8px 0;grid-template-columns:repeat(3,1fr)"><div class="kpi"><span>Draft $</span><b>${o.d}</b></div><div class="kpi"><span>Güncel $</span><b>${o.v}</b></div><div class="kpi"><span>Fark</span><b class="${o.v - o.d >= 0 ? "win" : "loss"}">${o.v - o.d > 0 ? "+" : ""}${o.v - o.d}</b></div></div>`; }
    h += `<div class="tw" style="margin-top:8px"><table class="small"><thead><tr><th>#</th><th class="l">Oyuncu</th>${degT ? "" : "<th>Takım</th>"}<th>Draft $</th><th>Güncel $</th><th>Fark</th></tr></thead><tbody>` +
      L2.map((p, i) => `<tr class="${p.t === cur ? "sel" : ""}" ><td>${i + 1}</td><td class="l" style="white-space:normal">${esc(p.n)}</td>${degT ? "" : `<td class="mut" style="max-width:74px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:.68rem;text-align:left">${esc(tn(p.t))}</td>`}<td>${p.d == null ? "FA" : "$" + p.d}</td><td><b>${p.v}</b></td>${fx(dif(p))}</tr>`).join("") + "</tbody></table></div>";
  }
  out.innerHTML = h;
  [...$("dg-m").children].forEach(b => b.onclick = () => { degM = b.dataset.m; setQ({ dm: degM }); renderDeg(); });
  const st = $("dg-t"), ss = $("dg-s");
  if (st) st.onchange = () => { degT = st.value; setQ({ dt: degT }); renderDeg(); };
  if (ss) ss.onchange = () => { degS = ss.value; renderDeg(); };
  out.onclick = e => { const r = e.target.closest("tr[data-t]"); if (r) { degM = "pl"; degT = r.dataset.t; setQ({ dm: degM, dt: degT }); renderDeg(); window.scrollTo(0, 0); return; }
     };
}
function standings(V) {
  const out = V.map(a => { let cw = 0, cl = 0, ct = 0, beats = 0; V.forEach(b => { if (a === b) return; const r = cmp(a, b); cw += r.w; cl += r.l; ct += r.t; if (r.w > r.l) beats++; }); return { team: a.team, cw, cl, ct, beats }; });
  out.sort((x, y) => (y.beats - x.beats) || ((y.cw + y.ct / 2) - (x.cw + x.ct / 2))); out.forEach((r, i) => r.rank = i + 1); return out;
}
function renderLeague() {
  if (lgSub === "val") { $("lg-wk").hidden = true; $("lg-upd").textContent = ""; chipRow($("lg-sub"), SUBS, lgSub, k => { lgSub = k; setQ({ s: k }); renderLeague(); }); renderDeg(); return; }
  $("lg-wk").hidden = false; $("lg-out").onclick = null;
  if (!DATA) { $("lg-out").innerHTML = "<p class='note'>Lig verisi yükleniyor…</p>"; return; }
  const ks = weekKeys(); if (!lgWk || !DATA.weeks[lgWk]) lgWk = ks[ks.length - 1];
  chipRow($("lg-wk"), weekItems(), lgWk, k => { lgWk = k; setQ({ w: k }); renderLeague(); });
  chipRow($("lg-sub"), SUBS, lgSub, k => { lgSub = k; setQ({ s: k }); renderLeague(); });
  const W = DATA.weeks[lgWk]; $("lg-upd").textContent = (W.label || "") + (W.updated ? " · güncelleme: " + W.updated : "");
  const V = vals(W.teams, false), names = V.map(v => v.team);
  if (!names.includes(lgA)) lgA = names.includes(cur) ? cur : names[0];
  if (!names.includes(lgB) || lgB === lgA) lgB = names.find(t => t !== lgA);
  const sel = t => (t === lgA || (lgSub === "h2h" && t === lgB)) ? "sel" : "";
  const out = $("lg-out"); let h = "";
  if (lgSub === "h2h") {
    const a = V.find(v => v.team === lgA), b = V.find(v => v.team === lgB), r = cmp(a, b);
    h = `<div class="pick">${teamOpts("la", lgA, names)}<span class="vs">VS</span>${teamOpts("lb", lgB, names)}</div>
<div class="score"><span class="a">${r.w}</span> – <span class="b">${r.l}</span></div>
<div class="verdict">${r.w > r.l ? esc(lgA) + " kazanıyor" : r.w < r.l ? esc(lgB) + " kazanıyor" : "Berabere"}${r.t ? " · " + r.t + " kategori berabere" : ""}</div><div class="card">` +
      CATS.map(k => { const x = a[k], y = b[k], mx = Math.max(x, y) || 1, isP = k === "fgp" || k === "ftp", fx = v => isP ? f3(v) : Math.round(v);
        return `<div class="cat"><span class="va${better(k, x, y) ? " wa" : ""}">${fx(x)}</span><div class="track a"><span style="width:${100 * x / mx}%"></span></div><span class="lbl">${LBL[k]}</span><div class="track b"><span style="width:${100 * y / mx}%"></span></div><span class="${better(k, y, x) ? "wb" : ""}">${fx(y)}</span></div>`; }).join("") + "</div>";
  } else if (lgSub === "all") {
    const c = V.find(v => v.team === lgA);
    h = teamOpts("la", lgA, names) + `<div class="tw" style="margin-top:8px"><table><thead><tr><th>Rakip</th><th>G</th><th>M</th><th>B</th><th>Sonuç</th></tr></thead><tbody>` +
      V.filter(o => o !== c).map(o => ({ o, r: cmp(c, o) })).sort((p, q) => (q.r.w - q.r.l) - (p.r.w - p.r.l)).map(({ o, r }) => {
        const res = r.w > r.l ? ["Kazanır", "win"] : r.w < r.l ? ["Kaybeder", "loss"] : ["Berabere", "tie"];
        return `<tr><td>${esc(o.team)}</td><td>${r.w}</td><td>${r.l}</td><td>${r.t}</td><td><span class="pill ${res[1]}">${res[0]}</span></td></tr>`; }).join("") + "</tbody></table></div>";
  } else if (lgSub === "pow") {
    h = `<p class="note">Her takım bu dönemin toplamlarıyla diğer herkese karşı eşleştirilseydi: yendiği rakip sayısı ve toplam kategori sonucu.</p><div class="tw"><table><thead><tr><th>Sıra</th><th class="l">Takım</th><th>Yendiği</th><th>Kat. G</th><th>M</th><th>B</th></tr></thead><tbody>` +
      standings(V).map(r => `<tr class="${sel(r.team)}"><td>${r.rank}</td><td class="l">${esc(r.team)}</td><td>${r.beats}</td><td>${r.cw}</td><td>${r.cl}</td><td>${r.ct}</td></tr>`).join("") + "</tbody></table></div>";
  } else if (lgSub === "cat") {
    const ranks = V.map(a => { const o = { team: a.team }; let s = 0; CATS.forEach(k => { o[k] = 1 + V.filter(b => better(k, b[k], a[k])).length; s += o[k]; }); o.avg = s / 9; return o; }).sort((x, y) => x.avg - y.avg);
    const rc = n => n <= 4 ? "win" : n >= V.length - 3 ? "loss" : "";
    h = `<button class="btn" id="catall">${catAll ? "Tek takım görünümü" : "Tüm takımlar tablosu"}</button>`;
    if (catAll) {
      h += `<p class="note">1 = ligin en iyisi. Ortalama sıraya göre dizildi; ilk 4 yeşil, son 4 kırmızı.</p><div class="tw"><table><thead><tr><th>Takım</th><th>Ort.</th>${CATS.map(k => `<th>${LBL[k]}</th>`).join("")}</tr></thead><tbody>` +
        ranks.map(o => `<tr class="${sel(o.team)}"><td>${esc(o.team)}</td><td>${o.avg.toFixed(1)}</td>${CATS.map(k => `<td class="${rc(o[k])}">${o[k]}</td>`).join("")}</tr>`).join("") + "</tbody></table></div>";
    } else {
      const o = ranks.find(x => x.team === lgA), a = V.find(v => v.team === lgA);
      h += teamOpts("la", lgA, names) + `<div class="card" style="margin-top:8px">` + CATS.map(k => `<div class="wrow" style="grid-template-columns:60px 1fr 52px"><div class="wl">${LBL[k]}</div><div class="mut">${k === "fgp" || k === "ftp" ? f3(a[k]) : Math.round(a[k])}</div><div class="wp ${rc(o[k])}">${o[k]}.</div></div>`).join("") +
        `<div class="wrow" style="grid-template-columns:60px 1fr 52px"><div class="wl">Ort.</div><div></div><div class="wp">${o.avg.toFixed(1)}</div></div></div>`;
    }
  } else if (lgSub === "tot") {
    const order = Object.fromEntries(standings(V).map(r => [r.team, r.rank]));
    h = `<p class="note">Yahoo'daki toplamlar, güç sırasına göre.</p><div class="tw"><table><thead><tr><th>Takım</th><th>Maç</th><th>FGM/A</th><th>FG%</th><th>FTM/A</th><th>FT%</th><th>3PM</th><th>PTS</th><th>REB</th><th>AST</th><th>ST</th><th>BLK</th><th>TO</th></tr></thead><tbody>` +
      V.slice().sort((x, y) => order[x.team] - order[y.team]).map(v => { const r = v.raw;
        return `<tr class="${sel(r.team)}"><td>${esc(r.team)}</td><td>${r.gp ?? "–"}</td><td>${r.fgm}/${r.fga}</td><td>${f3(v.fgp)}</td><td>${r.ftm}/${r.fta}</td><td>${f3(v.ftp)}</td><td>${r.tpm}</td><td>${r.pts}</td><td>${r.reb}</td><td>${r.ast}</td><td>${r.st}</td><td>${r.blk}</td><td>${r.to}</td></tr>`; }).join("") + "</tbody></table></div>";
  } else {
    const PG = vals(W.teams, true);
    const pgs = PG.map(a => { let w = 0; PG.forEach(b => { if (a !== b) CATS.forEach(k => { if (better(k, a[k], b[k])) w++; }); }); return { a, w }; }).sort((x, y) => y.w - x.w);
    h = `<p class="note">Takımlar farklı sayıda maç oynadığı için maç başına ortalamalar. Sıralama, bu ortalamalarla herkese karşı kazanılan kategori sayısına göre; Yahoo skorunu değil takımların gücünü gösterir.</p><div class="tw"><table><thead><tr><th>Sıra</th><th class="l">Takım</th><th>Maç</th><th>Kat. G</th><th>FG%</th><th>FT%</th><th>3PM</th><th>PTS</th><th>REB</th><th>AST</th><th>ST</th><th>BLK</th><th>TO</th></tr></thead><tbody>` +
      pgs.map(({ a, w }, i) => `<tr class="${sel(a.team)}"><td>${i + 1}</td><td class="l">${esc(a.team)}</td><td>${a.gp ?? "–"}</td><td>${w}</td><td>${f3(a.fgp)}</td><td>${f3(a.ftp)}</td>${["tpm", "pts", "reb", "ast", "st", "blk", "to"].map(k => `<td>${f1(a[k])}</td>`).join("")}</tr>`).join("") + "</tbody></table></div>";
  }
  out.innerHTML = h;
  const la = $("la"), lb = $("lb"), ca = $("catall");
  if (la) la.onchange = () => { lgA = la.value; setQ({ a: lgA }); renderLeague(); };
  if (lb) lb.onchange = () => { lgB = lb.value; setQ({ b: lgB }); renderLeague(); };
  if (ca) ca.onclick = () => { catAll = !catAll; renderLeague(); };
}

fetch("data.json?v=" + Date.now()).then(r => r.json()).then(d => { DATA = d; addSeason(d); renderLeague(); })
  .catch(() => { $("lg-out").innerHTML = "<p class='err'>Veriler yüklenemedi. Sayfayı yenile.</p>"; });
</script>
</body>
</html>
